# Copy to .env (chmod 600). Never commit .env or paste its values into a chat.

# --- Public URL (Cloudflare named tunnel; see README step 2)
PUBLIC_HOSTNAME=hooks.vasconmaz.com
CLOUDFLARE_TUNNEL_TOKEN=

# --- Safety switch: off | dry_run | live
# live ALSO requires "approved": true in copy.json (rebuild + re-import after approving).
AUTOREPLY_MODE=dry_run
# Optional during first live test: only these commenter IDs get real replies (comma-separated).
TEST_ONLY_USER_IDS=

# --- Meta app (developers.facebook.com > your app > App settings > Basic)
META_APP_SECRET=
# Any long random string; you type the same value in the Webhooks setup screen.
META_VERIFY_TOKEN=
# Use the newest version listed in the App Dashboard (Meta retires each one after ~2 years).
GRAPH_API_VERSION=v24.0

# --- Accounts. *_PAGE_TOKEN = long-lived Page access token of that brand's Facebook Page
# (the IG account must be linked to that Page; the same token serves both).
CONSTRUR3_PAGE_ID=
CONSTRUR3_IG_ID=
CONSTRUR3_PAGE_TOKEN=
VASCONMAZ_PAGE_ID=
VASCONMAZ_IG_ID=
VASCONMAZ_PAGE_TOKEN=

# --- Alerts for complaints / failed DMs, sent by WhatsApp via CallMeBot (free).
# One entry per person: <phone with country code, digits only>:<their CallMeBot apikey>, comma-separated.
# Example: 50212345678:123456,50287654321:654321   (see README "WhatsApp alerts")
ALERT_WHATSAPP=
# Optional extra/alternative channel: Slack/Discord incoming-webhook URL.
ALERT_WEBHOOK_URL=
